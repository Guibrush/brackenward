; Godot project configuration for brackenward.
;
; Hand-authored and deliberately minimal: this file makes the project exist, name
; itself, and declare the scene the game boots into. There are no autoloads.
;
; `run/main_scene` is what `scripts/gate/smoke.ps1` runs (G2.1). It points at the
; arena, which prints ARENA_SUMMARY so the gate can check the scene's own
; counters instead of trusting the exit code (L-035). See tasks/T-0026.md.
;
; Engine in use: Godot 4.7.2 stable (ADR-0001). config_version=5 is the Godot 4
; format. See tasks/T-0001.md.

config_version=5

[application]

config/name="brackenward"
run/main_scene="res://scenes/main.tscn"

; T-0051 - gamepad bindings the game owns.
;
; The map screen routes input through the built-in ui_* actions on the assumption
; that they carry joypad events. Measured in Godot 4.7.2: ui_accept and ui_cancel
; carry keyboard events only, so a pad cannot confirm or dismiss anything at all;
; ui_up and ui_down do carry a D-pad button and a left-stick axis. Depending on
; that split would make the charter's "playable on a gamepad" claim depend on
; which half of the UI a screen happens to use.
;
; These four actions are therefore explicit and each binds keyboard AND joypad.
; All events use device -1, which matches any connected pad (this is also what
; the engine itself writes for its own joypad defaults). Focus uses D-pad
; buttons rather than a stick axis so one press is one step. Deadzone 0.5 is the
; engine default and is unused: no axis events are bound here.
;
; The built-in ui_* actions are deliberately untouched - other code may rely on
; them, and changing them would change engine-wide behaviour.

[input]

game_focus_next={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194322,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":12,"pressure":0.0,"pressed":false,"script":null)
]
}
game_focus_prev={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":11,"pressure":0.0,"pressed":false,"script":null)
]
}
game_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
game_dismiss={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
