class_name RunMap
extends RefCounted

## The run map: nine layers of branching choices between the start and one boss.
## T-0040.
##
## CONTRACT
## --------
## * A caller creates one `RunMap` per run, calls `generate(seed)` once, and keeps
##   the object for the life of that run. It is a plain object: not an autoload,
##   not a node, no global.
## * This object owns exactly one piece of mutable state after generation: the
##   route the player has entered (`_route`, advanced only by `enter()`). The
##   generated graph is immutable once `generate()` returns true. Gold, HQ health
##   and the level index belong to `RunState`; this object neither reads nor
##   writes them, and it does not import that file.
## * Generation is a pure function of the seed and the tunable fields on this
##   object: the same seed on the same build produces the same map, and `sha()`
##   is the fingerprint that proves it. A configuration the rules reject returns
##   false, prints one `MAP_REFUSED` line naming every problem, leaves no map
##   behind (`node_count() == 0`), and repeats the reason in `last_refusal()`.
## * Structure, checked by `structure_errors()` before `generate()` returns true:
##     - 9 choice layers, 2-3 nodes each;
##     - every choice layer holds at least one `map` node;
##     - exactly one boss node, on the single-node final layer, with no children;
##     - every node reachable from the start;
##     - every node but the final layer has a child, every node but the first
##       layer has a parent.
## * The map never stores wave composition. A node carries its type, its level,
##   that level's active-tile count and its dominant enemy types; what spawns is
##   generated by the wave system from the level's parameters when the level is
##   played. `structure_errors()` asserts the absence rather than assuming it.
## * Reveal: a node is visible when the route has entered it, when it is a legal
##   next choice (a child of the node the route is on), or when it is a lure.
##   A lure widens visibility and nothing else: it is never excluded from the
##   legal next choices for being a lure, so a lure that is a child of the node
##   the route is on is selectable and enterable like any other. Reachability
##   alone decides selection; the map must never show a route it then refuses.
##   `knowledge()` describes visible nodes only — type, level, dominant enemy
##   types and active tiles. A type flagged `hidden_until_entry` reveals its
##   content only to the system that resolves it, never to the map.
## * Selection weighting: a map that appeared on the previous layer is drawn with
##   the lowest non-zero weight. It can happen — a run may revisit a map, which
##   the CHARTER wants — but nothing else is ever cheaper.
##
## CALLERS MUST
## ------------
## * Call `generate()` first and check its bool; on false, surface
##   `last_refusal()` instead of retrying silently.
## * Drive the run through `enter(node_id)` and check its bool; it refuses a node
##   that is not a legal next choice. Advance `RunState` in the same transition —
##   this object does not know what a level index is.
## * Ask `is_visible()` before showing anything and `knowledge()` for what to
##   show. Never render a node's level by reading the map for wave data: there is
##   none, and the client that needs waves asks the wave system.
## * Treat `max_levels()` as the ceiling, not the count: a route is 10 layers, but
##   store, rest, treasure and event nodes are not levels, so the number of levels
##   a given route contains depends on the route. `RunState.start()` needs a level
##   count up front and its index is not the same counter as the layer index; see
##   the T-0040 return for the owner that decision belongs to.
##
## PLACEHOLDER numbers
## -------------------
## Every number below is a guess made before the map has been played;
## `docs/design/systems/run-map.md`, `nodes.md` and `hidden-rules.md` (T-0038)
## own the real ones. Mutable tunables are mirrored on an instance field of the
## same meaning, so a playtest or the self-test can move one without editing this
## file. The structural counts are constants on purpose: 9 layers, 2-3 nodes and
## "at least one map node" are the brief's rules, and changing one is a design
## decision, not a tuning pass.

const RunMapNodeScript := preload("res://src/systems/run_map_node.gd")
const RunMapNodeTypeScript := preload("res://src/systems/run_map_types.gd")

# --- structure: fixed by the brief, checked, never tuned ---------------------

## Choice layers between the start and the boss.
const CHOICE_LAYERS := 9
const NODES_PER_LAYER_MIN := 2
const NODES_PER_LAYER_MAX := 3
const MAP_NODES_PER_LAYER_MIN := 1

## The distinct levels a run draws from: 8 standard maps plus 1 boss map
## (CHARTER scope budget). Reuse inside a run is deliberate (CHARTER, "map reuse
## is deliberate"), so two nodes — and two visited levels — may share a map.
const STANDARD_MAP_COUNT := 8
const BOSS_MAP_ID := "map-boss"

## PLACEHOLDER (T-0038 enemies.md): the boss the final level holds, and the two
## sub-bosses an elite's final wave carries.
const BOSS_ENEMY := "warden"
const SUB_BOSSES := ["bulwark", "herald"]

## Canonical-form version. Nothing is written to disk at G2, so no migration
## exists yet; the field is here so a future save can version this shape instead
## of guessing at an unversioned blob (eng/systems rule 3).
const FORMAT_VERSION := 1

# --- tunables: defaults, mirrored on instance fields -------------------------

## PLACEHOLDER (T-0038 run-map.md): share of choice layers that carry 3 nodes
## rather than 2, in percent. 50 gives an even split.
const DEFAULT_THREE_NODE_LAYER_WEIGHT := 50.0

## PLACEHOLDER (T-0038 nodes.md): nodes visible from the start as lures.
const DEFAULT_LURE_COUNT := 1

## PLACEHOLDER (T-0038 run-map.md): weight of a map that has not just been
## played. All such maps share it, so "weight" is relative inside this draw.
const DEFAULT_MAP_BASE_WEIGHT := 100.0

## PLACEHOLDER (T-0038 run-map.md): weight of the map played on the previous
## layer. The lowest non-zero value in the draw: a revisit is possible and always
## the least likely outcome, never impossible and never favoured.
const DEFAULT_PREVIOUS_MAP_WEIGHT := 8.0

## PLACEHOLDER (T-0038 hidden-rules.md, "familiar ground"): extra build tiles on
## a level whose map the route has already played once.
const DEFAULT_FAMILIAR_GROUND_BONUS := 1

## PLACEHOLDER (T-0038 nodes.md): build tiles per standard map, index-aligned
## with `map-01` .. `map-08`. A level's identity carries its tile count, so a
## revisit is the same level plus the familiar-ground tile.
const STANDARD_MAP_BASE_TILES := [10, 11, 9, 12, 10, 11, 9, 12]
const BOSS_MAP_BASE_TILES := 12

## PLACEHOLDER (T-0038 nodes.md): the 1-2 enemy types a map's waves lean on,
## index-aligned with `map-01` .. `map-08`. Revealed with the node; the actual
## wave manifest is not, and is not stored here.
const STANDARD_MAP_DOMINANT_ENEMIES := [
	["grunt", "runner"],
	["shieldback", "bloom"],
	["swarmling", "grunt"],
	["runner", "swarmling"],
	["bloom", "shieldback"],
	["grunt", "shieldback"],
	["runner", "bloom"],
	["swarmling", "runner"],
]

# --- tunable state (read at generate time) ----------------------------------

var three_node_layer_weight: float = DEFAULT_THREE_NODE_LAYER_WEIGHT
var lure_count: int = DEFAULT_LURE_COUNT
var map_base_weight: float = DEFAULT_MAP_BASE_WEIGHT
var previous_map_weight: float = DEFAULT_PREVIOUS_MAP_WEIGHT
var familiar_ground_bonus: int = DEFAULT_FAMILIAR_GROUND_BONUS
## id -> RunMapNodeType. Replaceable before `generate()`; see
## `RunMapNodeType` for what adding a type costs.
var node_types: Dictionary = RunMapNodeTypeScript.build_default_registry()

# --- generated state --------------------------------------------------------

var _seed: int = 0
var _generated: bool = false
var _nodes: Array = []
var _lures: Array = []
var _route: Array = []
var _last_refusal: String = ""
var _sha: String = ""


# --- generation -------------------------------------------------------------

## Builds the map for `seed_value`. `overrides` exists for authoring and for
## tests, not for play:
##     {"forced_types": {layer_index: [type_id, ...]}}
## pins a layer's node types (0-based layer, short nested arrays are the ids),
## which is how the self-test plants a layer with no map node. A pinned layer
## bypasses the "node 0 is a map" guarantee and still goes through the same
## structural validation, so a bad pin is refused rather than repaired.
##
## Returns false and prints one `MAP_REFUSED` line when any rule fails.
func generate(seed_value: int, overrides: Dictionary = {}) -> bool:
	_clear()
	_seed = seed_value
	var forced: Dictionary = overrides.get("forced_types", {})

	var problems: Array = config_errors()
	problems.append_array(weighting_errors())
	for key in forced.keys():
		problems.append_array(forced_layer_errors(int(key), forced[key]))
	if not problems.is_empty():
		return _refuse("generate a run map", problems, true)

	var rng := RandomNumberGenerator.new()
	rng.seed = _seed

	var previous_templates := {}
	for layer in CHOICE_LAYERS:
		var types: Array = []
		if forced.has(layer):
			for type_id in forced[layer]:
				types.append(str(type_id))
		else:
			# The guarantee lives here: node 0 of every choice layer is a map
			# node, so "at least one map node per layer" is true by construction
			# and never depends on a draw landing. The remaining 1-2 nodes are
			# drawn from the weights, so a layer often offers more than one.
			types.append(RunMapNodeTypeScript.TYPE_MAP)
			for i in _draw_layer_size(rng) - 1:
				types.append(_draw_type(rng, layer))

		var ids: Array = []
		for index in types.size():
			var node := RunMapNodeScript.new()
			node.id = _nodes.size()
			node.layer = layer
			node.index = index
			node.type_id = types[index]
			_fill_level(rng, node, previous_templates)
			_nodes.append(node)
			ids.append(node.id)
		previous_templates = _templates_in(ids)

	_build_boss()
	_build_edges()
	_assign_lures(rng)

	var errors: Array = structure_errors()
	if not errors.is_empty():
		return _refuse("generate a run map", errors, true)

	_generated = true
	_sha = _compute_sha()
	return true


func is_generated() -> bool:
	return _generated


func seed_value() -> int:
	return _seed


## SHA-256 of the canonical form. Two maps with the same sha have the same nodes,
## the same levels, the same edges and the same lures.
func sha() -> String:
	return _sha


## Why the most recent `generate()` or `enter()` was refused, or "" when none
## was. A refusal is never silent: it is stored and printed.
func last_refusal() -> String:
	return _last_refusal


# --- structure --------------------------------------------------------------

## Choice layers plus the boss layer: 10 layers, one of which ends the run.
func total_layers() -> int:
	return CHOICE_LAYERS + 1


## The ceiling on levels in a run, not the count: a route has 10 layers, but only
## nodes whose type plays a level become one.
func max_levels() -> int:
	return total_layers()


func node_count() -> int:
	return _nodes.size()


## Every node id in generation order (layer-major, then left to right).
func node_ids() -> Array:
	var ids: Array = []
	for node in _nodes:
		ids.append(node.id)
	return ids


## The node, or null when the id is not on this map. Callers check for null: an
## id from another map is a bug, not a state.
func node(node_id: int) -> RefCounted:
	if not _has(node_id):
		return null
	return _nodes[node_id]


## Node ids on `layer`, left to right. An empty array for a layer that does not
## exist on this map.
func nodes_in_layer(layer: int) -> Array:
	var ids: Array = []
	for node in _nodes:
		if node.layer == layer:
			ids.append(node.id)
	return ids


func type_of(node_id: int) -> String:
	var node := self.node(node_id)
	return "" if node == null else node.type_id


## Active build tiles on this node's level, including the familiar-ground bonus
## when the route has already played that map. 0 for a node that plays no level.
func active_tile_count(node_id: int) -> int:
	var node := self.node(node_id)
	if node == null or node.level_id == "":
		return 0
	var bonus := 0
	if _level_played(node.level_id, node_id):
		bonus = familiar_ground_bonus
	return node.base_active_tiles + bonus


# --- reveal -----------------------------------------------------------------

## 0-based index of the layer awaiting a choice. Starts at 0; after the boss is
## entered it is `total_layers()`, past the end of the map.
func current_layer() -> int:
	if _route.is_empty():
		return 0
	return int(_nodes[int(_route[-1])].layer) + 1


func route() -> Array:
	return _route.duplicate()


func current_node_id() -> int:
	if _route.is_empty():
		return -1
	return int(_route[-1])


func is_complete() -> bool:
	return not _route.is_empty() and int(_nodes[int(_route[-1])].layer) >= CHOICE_LAYERS


func is_lure(node_id: int) -> bool:
	return _lures.has(node_id)


## A node is visible when the route has entered it, when it is a legal next
## choice, or when it is a lure. Nothing beyond the next layer is visible.
func is_visible(node_id: int) -> bool:
	if not _has(node_id):
		return false
	if _route.has(node_id):
		return true
	if is_selectable(node_id):
		return true
	return bool(_nodes[node_id].lure)


## The legal next choices: the children of the node the route is on, or every
## layer-1 node at the start. Reachability decides this and nothing else — a lure
## is not excluded (it stays visible from the start, and becomes selectable once
## it is a legal child). Filtering lures out here made the map draw a route it
## then refused to enter; that was the T-0040 defect.
func is_selectable(node_id: int) -> bool:
	if not _has(node_id):
		return false
	var node: RefCounted = _nodes[node_id]
	if node.layer != current_layer():
		return false
	if _route.is_empty():
		return true
	return bool(_nodes[int(_route[-1])].children.has(node_id))


## Visible node ids, layer-major. Ascending within a layer, so a client can draw
## them in place.
func visible_nodes() -> Array:
	var ids: Array = []
	for node in _nodes:
		if is_visible(int(node.id)):
			ids.append(node.id)
	return ids


## Legal next choices, ascending.
func selectable_nodes() -> Array:
	var ids: Array = []
	for node in _nodes:
		if is_selectable(int(node.id)):
			ids.append(node.id)
	return ids


## What the player knows about a visible node, and nothing more:
##     id, layer (1-based), type, type_name, plays_level
##     level, active_tiles, dominant_enemies   when the type plays a level
##     boss_telegraph                          when the type telegraphs the boss
##     detail = "hidden_until_entry"           when the type is a blind roll
## A node that is not visible returns an empty dictionary: the map does not leak
## what it has not revealed.
##
## There is no wave key and there will not be one: wave composition is generated
## from the level's parameters, by another system, when the level is played.
func knowledge(node_id: int) -> Dictionary:
	if not is_visible(node_id):
		return {}
	var node: RefCounted = _nodes[node_id]
	var def = node_types.get(node.type_id)
	var type_name: String = node.type_id
	var plays := false
	if def != null:
		type_name = String(def.display_name)
		plays = bool(def.plays_level)
	var out := {
		"id": node.id,
		"layer": int(node.layer) + 1,
		"type": node.type_id,
		"type_name": type_name,
		"plays_level": plays,
		"lure": bool(node.lure),
	}
	if def != null and bool(def.hidden_until_entry) and not _route.has(node_id):
		out["detail"] = "hidden_until_entry"
		return out
	if node.level_id != "":
		out["level"] = node.level_id
		out["active_tiles"] = active_tile_count(node_id)
		out["dominant_enemies"] = node.dominant_enemy_types.duplicate()
	if def != null and bool(def.telegraphs_boss):
		out["boss_telegraph"] = BOSS_ENEMY
	return out


## Moves the route onto `node_id`. Legal only when `is_selectable()` agrees;
## anything else is refused with a reason and changes nothing.
func enter(node_id: int) -> bool:
	if not is_selectable(node_id):
		var why := "node %d is not a legal next choice" % node_id
		if not _has(node_id):
			why = "no node %d on this map" % node_id
		elif int(_nodes[node_id].layer) != current_layer():
			why = (
				"node %d is on layer %d, the route is on layer %d"
				% [node_id, int(_nodes[node_id].layer) + 1, current_layer() + 1]
			)
		return _refuse("enter node %d" % node_id, [why], false)
	_route.append(node_id)
	return true


# --- weighting --------------------------------------------------------------

## Weights for the next standard map, given the level ids on the previous layer.
## The previous map gets `previous_map_weight`; every other map gets
## `map_base_weight`. This is the single source of truth for the rule, used by
## both the draw and the assertion.
func map_weights(previous_ids: Array) -> Dictionary:
	var weights := {}
	for i in STANDARD_MAP_COUNT:
		var id := _template_id(i)
		weights[id] = previous_map_weight if previous_ids.has(id) else map_base_weight
	return weights


## Everything wrong with the weights, empty when the design rule holds:
## the previous map is drawn least often, and no weighting makes it impossible.
func weighting_errors() -> Array:
	var errors: Array = []
	if map_base_weight <= 0.0:
		errors.append(
			"a fresh map must have a weight above 0, got %s; with every map at 0 there is nothing to draw"
			% map_base_weight
		)
	if previous_map_weight <= 0.0:
		errors.append(
			"the immediately previous map must have a non-zero weight, got %s; the CHARTER keeps a revisit possible"
			% previous_map_weight
		)
	elif previous_map_weight >= map_base_weight:
		errors.append(
			"the immediately previous map must have the lowest non-zero weight: previous %s is not below the base weight %s"
			% [previous_map_weight, map_base_weight]
		)
	for id in node_types.keys():
		var def = node_types[id]
		if float(def.weight) < 0.0:
			errors.append("node type '%s' has a negative weight %s" % [id, def.weight])
	if _drawable_types(0).is_empty():
		errors.append("no node type is drawable on layer 1; every weight is 0 or gated to a later layer")
	return errors


## Everything wrong with the configuration, empty when it can produce a legal map.
func config_errors() -> Array:
	var errors: Array = []
	if three_node_layer_weight < 0.0 or three_node_layer_weight > 100.0:
		errors.append(
			"three_node_layer_weight is a percentage, got %s" % three_node_layer_weight
		)
	if lure_count < 0:
		errors.append("lure_count must be 0 or more, got %d" % lure_count)
	if familiar_ground_bonus < 0:
		errors.append("familiar_ground_bonus must be 0 or more, got %d" % familiar_ground_bonus)
	if STANDARD_MAP_BASE_TILES.size() != STANDARD_MAP_COUNT:
		errors.append(
			"STANDARD_MAP_BASE_TILES has %d entries, expected %d"
			% [STANDARD_MAP_BASE_TILES.size(), STANDARD_MAP_COUNT]
		)
	if STANDARD_MAP_DOMINANT_ENEMIES.size() != STANDARD_MAP_COUNT:
		errors.append(
			"STANDARD_MAP_DOMINANT_ENEMIES has %d entries, expected %d"
			% [STANDARD_MAP_DOMINANT_ENEMIES.size(), STANDARD_MAP_COUNT]
		)
	if not node_types.has(RunMapNodeTypeScript.TYPE_MAP):
		errors.append("the node registry has no 'map' type; every layer needs one")
	if not node_types.has(RunMapNodeTypeScript.TYPE_BOSS):
		errors.append("the node registry has no 'boss' type; the run has no ending")
	var boss_count := 0
	for id in node_types.keys():
		if bool(node_types[id].is_boss):
			boss_count += 1
	if boss_count != 1:
		errors.append("the registry declares %d boss types, expected exactly 1" % boss_count)
	return errors


## Every structural rule the brief names, checked against the generated nodes.
## Public so a caller or a test can re-run the same validation.
func structure_errors() -> Array:
	var errors: Array = []
	if _nodes.is_empty():
		errors.append("the map has no nodes")
		return errors

	var layer_count := total_layers()
	var by_layer := {}
	for node in _nodes:
		var layer := int(node.layer)
		if layer < 0 or layer >= layer_count:
			errors.append(
				"node %d sits on layer %d, outside 1-%d" % [node.id, layer + 1, layer_count]
			)
			continue
		if not by_layer.has(layer):
			by_layer[layer] = []
		by_layer[layer].append(node.id)

	for layer in layer_count:
		if not by_layer.has(layer):
			errors.append("layer %d has no nodes" % (layer + 1))
			continue
		if layer >= CHOICE_LAYERS:
			continue
		var ids: Array = by_layer[layer]
		if ids.size() < NODES_PER_LAYER_MIN or ids.size() > NODES_PER_LAYER_MAX:
			errors.append(
				"layer %d has %d nodes; the rule is %d-%d"
				% [layer + 1, ids.size(), NODES_PER_LAYER_MIN, NODES_PER_LAYER_MAX]
			)
		var map_nodes := 0
		for id in ids:
			if String(_nodes[int(id)].type_id) == RunMapNodeTypeScript.TYPE_MAP:
				map_nodes += 1
		if map_nodes < MAP_NODES_PER_LAYER_MIN:
			errors.append(
				"layer %d has no map node; at least %d is required"
				% [layer + 1, MAP_NODES_PER_LAYER_MIN]
			)

	var boss_ids: Array = []
	for node in _nodes:
		if node_types.has(node.type_id) and bool(node_types[node.type_id].is_boss):
			boss_ids.append(node.id)
	if boss_ids.size() != 1:
		errors.append("expected exactly 1 boss node, found %d" % boss_ids.size())
	else:
		var boss_id := int(boss_ids[0])
		var boss: RefCounted = _nodes[boss_id]
		if int(boss.layer) != CHOICE_LAYERS:
			errors.append(
				"the boss sits on layer %d; it must be on the final layer (%d)"
				% [int(boss.layer) + 1, CHOICE_LAYERS + 1]
			)
		if not boss.children.is_empty():
			errors.append("the boss has %d children; it is the final node" % boss.children.size())
		var final_ids: Array = by_layer.get(CHOICE_LAYERS, [])
		if final_ids.size() != 1:
			errors.append(
				"the final layer has %d nodes; the boss is the single final node"
				% final_ids.size()
			)

	for node in _nodes:
		if not node_types.has(node.type_id):
			errors.append("node %d has unknown type '%s'" % [node.id, node.type_id])
		if int(node.layer) < CHOICE_LAYERS and node.children.is_empty():
			errors.append("node %d on layer %d has no child" % [node.id, int(node.layer) + 1])
		# The map must not be able to hold a wave: the key set is the contract.
		var form: Dictionary = node.serialise()
		if form.has("waves") or form.has("wave"):
			errors.append(
				"node %d stores wave composition; the map must never hold it" % node.id
			)

	# Reachability from the start. Every layer-1 node is an entry point.
	var visited := {}
	var frontier: Array = []
	for id in by_layer.get(0, []):
		visited[int(id)] = true
		frontier.append(int(id))
	while not frontier.is_empty():
		var id: int = int(frontier.pop_back())
		for child in _nodes[id].children:
			if not visited.has(int(child)):
				visited[int(child)] = true
				frontier.append(int(child))
	for node in _nodes:
		if not visited.has(int(node.id)):
			errors.append(
				"node %d on layer %d is unreachable from the start"
				% [node.id, int(node.layer) + 1]
			)

	var has_parent := {}
	for node in _nodes:
		for child in node.children:
			has_parent[int(child)] = true
	for node in _nodes:
		if int(node.layer) > 0 and not has_parent.has(int(node.id)):
			errors.append("node %d on layer %d has no parent" % [node.id, int(node.layer) + 1])

	return errors


# --- serialisation ----------------------------------------------------------

## The canonical form. Hash this, diff this, print this; it is what "the same
## map" means.
func serialise() -> Dictionary:
	var layers: Array = []
	for layer in total_layers():
		var entries: Array = []
		for id in nodes_in_layer(layer):
			entries.append(_nodes[int(id)].serialise())
		layers.append(entries)
	return {
		"version": FORMAT_VERSION,
		"seed": _seed,
		"layers": layers,
		"lures": _lures.duplicate(),
	}


## Everything a HUD, a log line or a test wants about where the route stands.
func snapshot() -> Dictionary:
	return {
		"seed": _seed,
		"generated": _generated,
		"sha": _sha,
		"layers": total_layers(),
		"nodes": _nodes.size(),
		"current_layer": current_layer() + 1,
		"route": _route.duplicate(),
		"complete": is_complete(),
		"max_levels": max_levels(),
		"last_refusal": _last_refusal,
		"placeholder": "(placeholder numbers; T-0038 replaces them)",
	}


# --- internals: drawing -----------------------------------------------------

func _draw_layer_size(rng: RandomNumberGenerator) -> int:
	if NODES_PER_LAYER_MAX <= NODES_PER_LAYER_MIN:
		return NODES_PER_LAYER_MIN
	return (
		NODES_PER_LAYER_MAX
		if rng.randf() * 100.0 < three_node_layer_weight
		else NODES_PER_LAYER_MIN
	)


## Type ids eligible on `layer` (0-based), sorted so the draw order is a property
## of the ids and not of Dictionary insertion order.
func _drawable_types(layer: int) -> Array:
	var ids: Array = []
	for id in node_types.keys():
		var def = node_types[id]
		if bool(def.is_boss) or float(def.weight) <= 0.0:
			continue
		if layer + 1 < int(def.earliest_layer):
			continue
		ids.append(String(id))
	ids.sort()
	return ids


func _draw_type(rng: RandomNumberGenerator, layer: int) -> String:
	var ids := _drawable_types(layer)
	var total := 0.0
	for id in ids:
		total += float(node_types[id].weight)
	if total <= 0.0:
		# `config_errors()` refuses this before generation; the fallback keeps a
		# release build producing a legal layer rather than an empty one.
		return RunMapNodeTypeScript.TYPE_MAP
	var roll := rng.randf() * total
	var running := 0.0
	for id in ids:
		running += float(node_types[id].weight)
		if roll < running:
			return String(id)
	return String(ids[ids.size() - 1])


func _draw_template(rng: RandomNumberGenerator, previous_templates: Dictionary) -> String:
	var weights := map_weights(previous_templates.keys())
	var ids: Array = weights.keys()
	ids.sort()
	var total := 0.0
	for id in ids:
		total += float(weights[id])
	if total <= 0.0:
		return _template_id(0)
	var roll := rng.randf() * total
	var running := 0.0
	for id in ids:
		running += float(weights[id])
		if roll < running:
			return String(id)
	return String(ids[ids.size() - 1])


func _template_id(index: int) -> String:
	return "map-%02d" % (index + 1)


func _template_index(level_id: String) -> int:
	for i in STANDARD_MAP_COUNT:
		if _template_id(i) == level_id:
			return i
	return 0


## Gives a node that plays a level its level, tiles and dominant enemies. Types
## that play no level keep an empty level id, which is what `knowledge()` and
## `active_tile_count()` branch on.
func _fill_level(
	rng: RandomNumberGenerator, node: RefCounted, previous_templates: Dictionary
) -> void:
	var def = node_types.get(node.type_id)
	if def == null or not bool(def.plays_level):
		return
	var level_id := _draw_template(rng, previous_templates)
	var index := _template_index(level_id)
	node.level_id = level_id
	node.base_active_tiles = int(STANDARD_MAP_BASE_TILES[index])
	node.dominant_enemy_types = (STANDARD_MAP_DOMINANT_ENEMIES[index] as Array).duplicate()
	if String(node.type_id) == RunMapNodeTypeScript.TYPE_ELITE and not SUB_BOSSES.is_empty():
		# An elite is a standard map whose final wave carries a sub-boss. The
		# sub-boss is reveal information — that is the point of an elite — so it
		# joins the dominant enemy list, not the wave manifest.
		node.dominant_enemy_types.append(SUB_BOSSES[rng.randi_range(0, SUB_BOSSES.size() - 1)])


func _templates_in(ids: Array) -> Dictionary:
	var used := {}
	for id in ids:
		var level_id := String(_nodes[int(id)].level_id)
		if level_id != "":
			used[level_id] = true
	return used


func _build_boss() -> void:
	var boss := RunMapNodeScript.new()
	boss.id = _nodes.size()
	boss.layer = CHOICE_LAYERS
	boss.index = 0
	boss.type_id = RunMapNodeTypeScript.TYPE_BOSS
	boss.level_id = BOSS_MAP_ID
	boss.base_active_tiles = BOSS_MAP_BASE_TILES
	boss.dominant_enemy_types = [BOSS_ENEMY]
	_nodes.append(boss)


## Edges are monotone: node i of a layer leads to the node it maps onto in the
## next layer and, when there is room, to the one after it. Every node ends with
## at least one child and starts with at least one parent, and the boss layer has
## a single node, so every layer-9 node leads to the boss. No random draw, so an
## edge can never be the reason two seeds differ.
func _build_edges() -> void:
	for layer in total_layers() - 1:
		var current := nodes_in_layer(layer)
		var following := nodes_in_layer(layer + 1)
		var a := current.size()
		var b := following.size()
		if a == 0 or b == 0:
			continue
		for i in a:
			var start := int(floor(float(i) * float(b) / float(a)))
			start = clampi(start, 0, b - 1)
			_connect(int(current[i]), int(following[start]))
			if b > 1:
				_connect(int(current[i]), int(following[clampi(start + 1, 0, b - 1)]))


func _connect(from_id: int, to_id: int) -> void:
	var children: Array = _nodes[from_id].children
	if children.has(to_id):
		return
	children.append(to_id)
	children.sort()
	_nodes[from_id].children = children


func _assign_lures(rng: RandomNumberGenerator) -> void:
	var candidates: Array = []
	for node in _nodes:
		var layer := int(node.layer)
		if layer >= 1 and layer < CHOICE_LAYERS:
			candidates.append(int(node.id))
	var count := mini(lure_count, candidates.size())
	for i in count:
		var pick := rng.randi_range(0, candidates.size() - 1)
		var id := int(candidates[pick])
		candidates.remove_at(pick)
		_nodes[id].lure = true
		_lures.append(id)
	_lures.sort()


# --- internals: validation, state -------------------------------------------

## A pinned layer is authoring input, so its shape is checked before it reaches
## the generator: an unknown type or a boss would make the error message about
## the pin, not about the map.
func forced_layer_errors(layer: int, types: Variant) -> Array:
	var errors: Array = []
	if layer < 0 or layer >= CHOICE_LAYERS:
		errors.append(
			"forced layer %d is outside 1-%d" % [layer + 1, CHOICE_LAYERS]
		)
	if not (types is Array):
		errors.append("forced layer %d must be an array of type ids" % (layer + 1))
		return errors
	var list: Array = types
	if list.size() < NODES_PER_LAYER_MIN or list.size() > NODES_PER_LAYER_MAX:
		errors.append(
			"forced layer %d has %d nodes; the rule is %d-%d"
			% [layer + 1, list.size(), NODES_PER_LAYER_MIN, NODES_PER_LAYER_MAX]
		)
	for type_id in list:
		var id := str(type_id)
		if not node_types.has(id):
			errors.append("forced layer %d names unknown node type '%s'" % [layer + 1, id])
		elif bool(node_types[id].is_boss):
			errors.append(
				"forced layer %d names the boss type; the boss is placed on the final layer, never pinned"
				% (layer + 1)
			)
	return errors


func _level_played(level_id: String, except_node_id: int) -> bool:
	for id in _route:
		if int(id) == except_node_id:
			continue
		if String(_nodes[int(id)].level_id) == level_id:
			return true
	return false


func _has(node_id: int) -> bool:
	return node_id >= 0 and node_id < _nodes.size()


func _compute_sha() -> String:
	return JSON.stringify(serialise(), "", true).sha256_text()


func _clear() -> void:
	_generated = false
	_nodes.clear()
	_lures.clear()
	_route.clear()
	_last_refusal = ""
	_sha = ""


## One place where refusals are worded, stored and printed. Returns false so a
## caller can `return _refuse(...)`. Loud in a development build, one greppable
## line in every build.
##
## `clear_map` is true for a rejected generation — a refused map must not be left
## half-built for a caller to render — and false for a refused move, which must
## leave the live route exactly as it was.
func _refuse(action: String, errors: Array, clear_map: bool) -> bool:
	if clear_map:
		_generated = false
		_nodes.clear()
		_lures.clear()
		_route.clear()
		_sha = ""
	var parts: Array = []
	for error in errors:
		parts.append(str(error))
	_last_refusal = "; ".join(parts)
	print("MAP_REFUSED " + JSON.stringify({
		"action": action,
		"reason": _last_refusal,
		"errors": parts,
	}))
	return false
