class_name WavePlan
extends Resource

## A level's waves, generated from the tables in `docs/design/systems/waves.md`
## (T-0039).
##
## The rule this whole file exists to obey, stated once in `waves.md` and once in
## `docs/CHARTER.md`: **difficulty is a function of `level_index` and of nothing
## else** — not of gold, not of HQ, not of tower count, not of leaks. There is no
## anti-snowball, no rubber-banding and no mercy scaling: "broken builds" are the
## intended feature.
##
## Level 1 is *not* generated. `level1_template` is the calibration level written
## out unit for unit in `waves.md` §Level 1, because `economy.md` §Worked example
## is priced against it and the design says rewriting the curve must not move it.
## Every other level is generated by the composition rule.
##
## Numbers marked PLACEHOLDER are `GUESS` values from `waves.md` until a human
## plays a full run (G2.2); each one is an exported field so moving it is a data
## change, never an edit to this code.
##
## Divergences from `waves.md`, recorded rather than hidden:
##   * **Sub-boss placement.** The design tables put the sub-boss on wave 5 of
##     6-8 (`enemies.md` §Sub-bosses); `tasks/T-0039.md` puts it on the **final**
##     wave. The brief wins, and the divergence is in the return envelope.
##   * **Spawn order.** `waves.md` §Composition rule 6 asks for spawns
##     "interleaved in blocks of three" when two or more types are present. This
##     plan orders the lines by descending threat per unit — which is the same
##     rule's stated reason, "the biggest thing is never hidden behind ten
##     grunts" — and `WaveDirector` spawns one line after another. Interleaving
##     is not implemented.
##   * **Grunt speed.** The roster's Grunt walks at 100 px/s, not `enemies.md`'s
##     60. `wave_entry.gd` records why: `scripts/tests/cases/leak_damage.gd`
##     waits 600 physics frames for the first arrival, and 800 px at 60 px/s is
##     800 frames.
##   * **Level 1's wave budgets.** `waves.md`'s budget table rounds level 1's
##     wave 6 to 25.0 where the curve gives 24.5. It does not matter: level 1
##     uses the hand-authored template, and the budgets are only consulted for an
##     *elite* level 1's reduced final wave.

@export_group("Curve — PLACEHOLDER (waves.md §The scale)")
## Threat in a level at `level_index` 1. Waves.md's reason for the bound: below
## 60 the first level teaches nothing, above 110 it needs two towers the player
## cannot own yet. Range 60-110.
@export var level1_threat: float = 82.0
## The geometric growth between levels — the single most important number in
## `waves.md`, and the one most likely to be wrong. Range 1.12-1.30.
@export var level_growth: float = 1.20
## The ratio between two consecutive waves inside one level. Range 1.20-1.45.
@export var wave_ramp: float = 1.32
## How much the spawn interval tightens per level. Range 0.88-1.00.
@export var tighten: float = 0.94
## No two enemies closer than this: below it they occupy the same 32 px of lane
## and cannot be counted. Range 0.4-0.8 s.
@export var interval_floor: float = 0.5
## Above this a six-unit wave trickles for 16 s and reads as a bug. Range
## 2.0-3.5 s.
@export var interval_ceiling: float = 2.6
## Units per wave ceiling. A performance and readability limit measured by G2.3;
## the rule is to swap cheap units for heavier ones, never to raise this. Range
## 30-60.
@export var unit_cap_per_wave: int = 40
## The highest level a run can legally reach; anything above is clamped and
## logged (`waves.md` §Edge cases).
@export var max_level_index: int = 10

@export_group("Elite — PLACEHOLDER (waves.md §The elite finale)")
## An elite's final wave keeps this share of the generated trash budget; the
## sub-boss itself is *not* bought from it. Range 0.45-0.75.
@export var elite_final_trash_fraction: float = 0.60
## Who an elite's wall is. Uniform at generation time, so the choice is fixed
## before the player commits to the node (`nodes.md` §Reveal).
@export var sub_boss_pool: Array[StringName] = [&"bulwark", &"herald"]
## How many sub-bosses an elite's final wave carries. The design allows **exactly
## one** — a second is illegal (`waves.md` §Edge cases, "two sub-bosses on one
## elite") — and the field is an int rather than a bool so the count is visible to
## `validate_level()` and to T-0039's planted failure B instead of assumed.
@export var elite_sub_boss_picks: int = 1
## Sub-boss HP growth per level index. 0.0 is the design: the sub-boss is the
## run's only non-scaling wall, which is the elite's entire design. Range
## 0.0-0.15 (`waves.md`).
@export var elite_sub_boss_health_scale_per_level: float = 0.0

@export_group("Determinism")
## Seed of the plan for `level_index` is this plus the index, so one level always
## builds the same waves — a demo, a bug report and a replay all see the same
## numbers — while two levels never draw the same sequence.
@export var seed_base: int = 3900

@export_group("Data — PLACEHOLDER (waves.md, enemies.md)")
## One template line per enemy kind: hit points, kill gold and speed
## (`enemies.md`, `economy.md`). `count` and `spacing_seconds` are overwritten by
## the plan; they exist because `WaveEntry` requires them.
@export var roster: Array[WaveEntry] = []
## Threat cost per unit, from `enemies.md` §Threat cost. Derived there, cited
## here, so a re-derivation is one number.
@export var threat_by_kind: Dictionary = {
	&"grunt": 1.0,
	&"runner": 1.0,
	&"shieldback": 2.5,
	&"swarmling": 0.5,
	&"bloom": 4.0,
	&"bulwark": 25.0,
	&"herald": 19.0,
}
## How many units arrive as one spawn event. One pack of 6 Swarmlings costs 3
## threat and spawns all six at once (`enemies.md` §Damage rules).
@export var pack_by_kind: Dictionary = {&"swarmling": 6}
## The allowed set and the weights *per level band*, verbatim from
## `waves.md` §The composition rule. Weights are shares of a wave's budget, not
## of its unit count.
@export var weight_tables: Dictionary = {
	"1": {&"grunt": 70, &"runner": 30},
	"2": {&"grunt": 60, &"runner": 25, &"swarmling": 15},
	"3-4": {&"grunt": 35, &"runner": 25, &"shieldback": 30, &"swarmling": 10},
	"5-6": {&"grunt": 25, &"runner": 20, &"shieldback": 25, &"swarmling": 15, &"bloom": 15},
	"7-9": {&"grunt": 20, &"runner": 20, &"shieldback": 25, &"swarmling": 20, &"bloom": 15},
}
## Base spawn interval, indexed by wave number (`waves.md` §Spawn interval).
@export var base_intervals: Array[float] = [2.2, 2.0, 1.9, 1.7, 1.5, 1.3, 1.2, 1.1]

## The calibration level, unit for unit: `waves.md` §Level 1. One entry per wave,
## each a list of `[kind, count]` pairs. Deliberately *not* exported and not
## tunable: moving this table is a design change that also moves
## `economy.md` §Worked example.
var level1_template: Array = []


func _init() -> void:
	if roster.is_empty():
		roster = _default_roster()
	if level1_template.is_empty():
		level1_template = _default_level1_template()


## The eight enemies' numbers, `enemies.md` and `economy.md`, as one row each.
## The Grunt's speed is the one deliberate departure; see the file header.
func _default_roster() -> Array[WaveEntry]:
	var lines: Array[WaveEntry] = []
	lines.append(WaveEntry.make(&"grunt", 1, 1.0, 40, 2, 100.0))
	lines.append(WaveEntry.make(&"runner", 1, 1.0, 24, 3, 110.0))
	lines.append(WaveEntry.make(&"shieldback", 1, 1.0, 90, 6, 45.0))
	lines.append(WaveEntry.make(&"swarmling", 1, 1.0, 8, 1, 75.0))
	lines.append(WaveEntry.make(&"bloom", 1, 1.0, 120, 9, 50.0))
	lines.append(WaveEntry.make(&"bulwark", 1, 1.0, 900, 60, 35.0))
	lines.append(WaveEntry.make(&"herald", 1, 1.0, 450, 45, 90.0))
	return lines


## `waves.md` §Level 1, transcribed. Budgets are not stored: the table is a unit
## list and the plan's job is to keep it exactly that.
func _default_level1_template() -> Array:
	return [
		[[&"grunt", 6]],
		[[&"grunt", 6], [&"runner", 2]],
		[[&"grunt", 8], [&"runner", 2]],
		[[&"grunt", 10], [&"runner", 4]],
		[[&"grunt", 12], [&"runner", 6]],
		[[&"grunt", 15], [&"runner", 10]],
	]


# --- the level curve --------------------------------------------------------

## Waves in a level: 6 at levels 1-3, 7 at 4-6, 8 from 7 up (`waves.md` §The
## scale). A run is 5-10 levels long, so this is the whole range that matters.
func wave_count_for(level_index: int) -> int:
	if level_index <= 3:
		return 6
	if level_index <= 6:
		return 7
	return 8


## Total threat a level is allowed to spend. `level_index` 0 or below is illegal
## and returns 0 here; `build()` is what refuses it, with a printed reason.
func total_threat_for(level_index: int) -> float:
	if level_index < 1:
		return 0.0
	return round(level1_threat * pow(level_growth, float(level_index - 1)))


## The geometric split of a level's threat between its waves, each rounded to
## 0.5 (`waves.md` §What a wave is made of). The last wave is always the largest
## and the first always the smallest: a wave 1 that leaks means the level is
## mis-scaled, never that the wave was hard.
func budgets_for(level_index: int) -> Array[float]:
	var budgets: Array[float] = []
	var count := wave_count_for(level_index)
	var total := total_threat_for(level_index)
	if count <= 0 or total <= 0.0:
		return budgets
	var ramp_sum := 0.0
	for w in count:
		ramp_sum += pow(wave_ramp, float(w))
	for w in count:
		budgets.append(_round_half(total * pow(wave_ramp, float(w)) / ramp_sum))
	return budgets


## Seconds between two arrivals in wave `wave_number` at this level, clamped to
## the design's floor and ceiling (`waves.md` §Spawn interval).
func interval_for(wave_number: int, level_index: int) -> float:
	var base := 2.2
	if base_intervals.size() > 0:
		base = base_intervals[clampi(wave_number - 1, 0, base_intervals.size() - 1)]
	var raw := base * pow(tighten, float(maxi(level_index, 1) - 1))
	return clampf(raw, interval_floor, interval_ceiling)


## Which row of `weight_tables` a level uses. Stated as a function, not a table of
## ten rows, because the design states it as bands.
func band_for(level_index: int) -> String:
	if level_index <= 1:
		return "1"
	if level_index == 2:
		return "2"
	if level_index <= 4:
		return "3-4"
	if level_index <= 6:
		return "5-6"
	return "7-9"


func weights_for(level_index: int) -> Dictionary:
	var band: String = band_for(level_index)
	var table = weight_tables.get(band, {})
	if not (table is Dictionary):
		return {}
	return table


# --- building a level -------------------------------------------------------

## The level's waves, in order. Empty when `level_index` is illegal — refused
## with a printed reason, because a level that silently builds zero waves is a
## level that never starts and looks like a hang.
func build(level_index_in: int, elite_in: bool = false) -> Array[WaveDefinition]:
	var waves: Array[WaveDefinition] = []
	if level_index_in < 1:
		print("WAVE_PLAN_REFUSED " + JSON.stringify({
			"level_index": level_index_in,
			"reason": "a level index below 1 is illegal: the growth curve would make level zero the easiest wave in the game",
		}))
		return waves

	var index := level_index_in
	if index > max_level_index:
		index = max_level_index
		print("WAVE_PLAN_CLAMPED " + JSON.stringify({
			"asked": level_index_in,
			"used": index,
			"reason": "the run cannot legally pass level %d" % max_level_index,
		}))

	var rng := RandomNumberGenerator.new()
	rng.seed = seed_base + index

	if index == 1:
		waves = _level_one_waves(elite_in, rng)
	else:
		waves = _generated_waves(index, elite_in, rng)

	var why := validate_level(index, elite_in, waves)
	if why != "":
		print("WAVE_PLAN_WARNING " + JSON.stringify({
			"level_index": index,
			"elite": elite_in,
			"reason": why,
		}))
	return waves


## Level 1: the calibration table, wave for wave. An *elite* level 1 cannot use
## its table for the final wave, because the sub-boss needs a wave sized for it;
## that one wave is generated at the reduced trash budget and the rest of the
## level is still the table.
func _level_one_waves(elite_in: bool, rng: RandomNumberGenerator) -> Array[WaveDefinition]:
	var waves: Array[WaveDefinition] = []
	var count := mini(level1_template.size(), wave_count_for(1))
	var budgets := budgets_for(1)
	for i in count:
		var number := i + 1
		var is_final := i == count - 1
		var wave: WaveDefinition
		if elite_in and is_final:
			var trash := _round_half(budgets[i] * elite_final_trash_fraction)
			wave = _compose(number, trash, 1, rng)
		else:
			wave = WaveDefinition.new()
			wave.number = number
			var interval := interval_for(number, 1)
			for pair in level1_template[i]:
				wave.entries.append(_line_for(pair[0], int(pair[1]), interval))
		if elite_in and is_final:
			_attach_sub_boss(wave, 1, rng)
		waves.append(wave)
	return waves


func _generated_waves(index: int, elite_in: bool, rng: RandomNumberGenerator) -> Array[WaveDefinition]:
	var waves: Array[WaveDefinition] = []
	var count := wave_count_for(index)
	var budgets := budgets_for(index)
	for i in count:
		var number := i + 1
		var is_final := i == count - 1
		var budget := budgets[i] if i < budgets.size() else 0.0
		if elite_in and is_final:
			budget = _round_half(budget * elite_final_trash_fraction)
		var wave := _compose(number, budget, index, rng)
		if elite_in and is_final:
			_attach_sub_boss(wave, index, rng)
		waves.append(wave)
	return waves


## One wave from its budget: draw up to three types, split the budget between
## them under the per-type cap, round the shares into legal packs, spend the
## remainder on the heaviest type present, and order the lines so the heaviest
## arrives first.
func _compose(number: int, budget: float, index: int, rng: RandomNumberGenerator) -> WaveDefinition:
	var wave := WaveDefinition.new()
	wave.number = number
	if budget <= 0.0:
		# Legal in the design's "breathing wave", illegal as a *unit* count: the
		# wave has no lines, and `WaveDefinition.validate()` refuses it with a
		# printed reason rather than letting a level stall.
		return wave

	var weights := weights_for(index)
	var max_types := 1 if number <= 2 else (2 if number <= 4 else 3)
	var kinds := _draw_types(weights, mini(max_types, weights.size()), rng)
	var cap := _cap_fraction(number)
	var split := _split(budget, kinds, weights, cap)

	# The unit cap is a readability limit, so the answer to "too many units" is
	# heavier types, never a raised cap (`waves.md` rule 7).
	var guard := 0
	while _planned_units(split) > unit_cap_per_wave and kinds.size() > 1 and guard < 8:
		kinds.erase(_cheapest_kind(kinds))
		split = _split(budget, kinds, weights, cap)
		guard += 1

	var interval := interval_for(number, index)
	var entries := _entries_from_split(budget, split, interval)
	_trim_to_cap(entries, number)
	entries.sort_custom(_heavier_first)
	wave.entries = entries
	return wave


## An elite's final wave: the trash above, then exactly one sub-boss leading it.
## `picks` above one puts the extra picks into the wave's trash lines, which is
## the shape the bug actually takes and the reason `validate_level()` counts
## sub-bosses wherever they are.
func _attach_sub_boss(wave: WaveDefinition, index: int, rng: RandomNumberGenerator) -> void:
	var interval := interval_for(wave.number, index)
	for pick in maxi(elite_sub_boss_picks, 0):
		if sub_boss_pool.is_empty():
			print("WAVE_PLAN_WARNING " + JSON.stringify({
				"reason": "an elite level was asked for a sub-boss with an empty pool; its final wave carries none",
			}))
			return
		var kind: StringName = sub_boss_pool[rng.randi_range(0, sub_boss_pool.size() - 1)]
		var line := _line_for(kind, 1, interval)
		if pick == 0:
			line.max_health = _scaled_sub_boss_health(line.max_health, index)
			wave.sub_boss = line
		else:
			line.max_health = _scaled_sub_boss_health(line.max_health, index)
			wave.entries.append(line)


func _scaled_sub_boss_health(base: int, index: int) -> int:
	var factor := 1.0 + elite_sub_boss_health_scale_per_level * float(maxi(index, 1) - 1)
	return maxi(int(round(float(base) * factor)), 1)


# --- the composition rule ---------------------------------------------------

## Before wave 5 no type may take more than 60% of a wave's budget, after it 70%
## (`waves.md` §The composition rule, step 4).
func _cap_fraction(wave_number: int) -> float:
	return 0.60 if wave_number < 5 else 0.70


## Draws up to `want` distinct kinds without replacement, weighted by the band's
## table. A kind that is drawn is removed, so no wave ever lists a type twice.
func _draw_types(weights: Dictionary, want: int, rng: RandomNumberGenerator) -> Array[StringName]:
	var kinds: Array[StringName] = []
	var pending := weights.keys()
	for i in mini(want, pending.size()):
		var total := 0.0
		for candidate in pending:
			total += _weight(candidate, weights)
		if total <= 0.0:
			break
		var roll := rng.randf() * total
		var chosen: StringName = &""
		for candidate in pending:
			roll -= _weight(candidate, weights)
			if roll <= 0.0:
				chosen = candidate
				break
		if chosen == &"":
			chosen = pending[pending.size() - 1]
		kinds.append(chosen)
		pending.erase(chosen)
	return kinds


## Splits `budget` between `kinds` in proportion to their weights, applies the
## per-type cap, and hands the capped excess to the types that are still under it.
## One pass is enough: capping raises the others, and the cap is a share of the
## budget that no single type can exceed twice over at three types.
func _split(budget: float, kinds: Array[StringName], weights: Dictionary, cap: float) -> Dictionary:
	var shares: Dictionary = {}
	if kinds.is_empty():
		return shares
	var total := 0.0
	for kind in kinds:
		total += _weight(kind, weights)
	if total <= 0.0:
		for kind in kinds:
			shares[kind] = budget / float(kinds.size())
		return shares
	for kind in kinds:
		shares[kind] = budget * _weight(kind, weights) / total

	var ceiling := budget * cap
	var excess := 0.0
	var under: Array[StringName] = []
	for kind in kinds:
		if float(shares[kind]) > ceiling:
			excess += float(shares[kind]) - ceiling
			shares[kind] = ceiling
		else:
			under.append(kind)
	if excess <= 0.0 or under.is_empty():
		return shares
	var room := 0.0
	for kind in under:
		room += float(shares[kind])
	if room <= 0.0:
		return shares
	for kind in under:
		shares[kind] = float(shares[kind]) + excess * float(shares[kind]) / room
	return shares


## Turns threat shares into legal packs of units. Rounding is down, so a wave's
## spend is never above its budget (`waves.md` step 5).
func _entries_from_split(budget: float, split: Dictionary, interval: float) -> Array[WaveEntry]:
	var entries: Array[WaveEntry] = []
	var spent := 0.0
	for kind in split:
		var share := float(split[kind])
		var count := _units_for(kind, share)
		if count < 1:
			continue
		entries.append(_line_for(kind, count, interval))
		spent += float(count) * _threat(kind)

	# Spend the remainder on the heaviest type present, and discard what is below
	# the cheapest legal pack. Budget is never carried between waves.
	var heaviest: WaveEntry = null
	for entry in entries:
		if heaviest == null or _threat(entry.kind) > _threat(heaviest.kind):
			heaviest = entry
	if heaviest != null:
		var extra := _units_for(heaviest.kind, budget - spent)
		if extra > 0:
			heaviest.count += extra
	return entries


## Units of `kind` that `threat_share` buys, rounded down to whole packs. The
## epsilon is there because `6.0 / 1.0` in floats is not always exactly 6.0, and a
## plan that loses a unit to the last bit of a mantissa is a plan nobody can
## reproduce.
func _units_for(kind: StringName, threat_share: float) -> int:
	var per := _threat(kind)
	if per <= 0.0:
		return 0
	var pack := _pack(kind)
	return pack * int(floor(threat_share / (per * float(pack)) + 1e-6))


func _planned_units(split: Dictionary) -> int:
	var units := 0
	for kind in split:
		units += _units_for(kind, float(split[kind]))
	return units


func _cheapest_kind(kinds: Array[StringName]) -> StringName:
	var cheapest: StringName = kinds[0]
	for kind in kinds:
		if _threat(kind) < _threat(cheapest):
			cheapest = kind
	return cheapest


## Last resort when even one type cannot spend the budget under the cap: drop
## units from the cheapest line and print what was lost. A wave over the cap is a
## frame-rate bug (G2.3), so the cap wins over the budget.
func _trim_to_cap(entries: Array[WaveEntry], number: int) -> void:
	var units := 0
	for entry in entries:
		units += maxi(entry.count, 0)
	if units <= unit_cap_per_wave:
		return
	var excess := units - unit_cap_per_wave
	var dropped := excess
	entries.sort_custom(_cheaper_first)
	for entry in entries:
		if excess <= 0:
			break
		var take := mini(entry.count, excess)
		entry.count -= take
		excess -= take
	for i in range(entries.size() - 1, -1, -1):
		if entries[i].count < 1:
			entries.remove_at(i)
	print("WAVE_PLAN_TRIMMED " + JSON.stringify({
		"wave": number,
		"unit_cap": unit_cap_per_wave,
		"dropped_units": dropped,
	}))


# --- validation -------------------------------------------------------------

## Why this level cannot be run, or "" when it can. Called by `build()` on every
## plan it produces, so a generator bug cannot ship as "a level that spawns
## nothing" or as "an elite with two walls".
func validate_level(level_index: int, elite_in: bool, waves: Array) -> String:
	if level_index < 1:
		return "level_index %d is illegal" % level_index
	if waves.is_empty():
		return "level %d built no waves" % level_index
	if elite_in and sub_boss_pool.is_empty():
		return "level %d is elite but its sub-boss pool is empty" % level_index

	var sub_bosses := _sub_boss_kinds()
	var total_sub_bosses := 0
	for i in waves.size():
		var wave = waves[i]
		if wave == null:
			return "level %d wave %d is null" % [level_index, i + 1]
		var why: String = wave.validate()
		if why != "":
			return "level %d: %s" % [level_index, why]
		var carried: int = wave.units_of_kind(sub_bosses)
		total_sub_bosses += carried
		if wave.sub_boss != null and not sub_bosses.has(wave.sub_boss.kind):
			return "level %d wave %d carries sub-boss '%s', which is not in the pool %s" % [
				level_index, wave.number, wave.sub_boss.kind, sub_bosses
			]
		if not elite_in and carried > 0:
			return "level %d wave %d carries %d sub-boss(es) on a normal level" % [
				level_index, wave.number, carried
			]
		if elite_in:
			var is_final := i == waves.size() - 1
			if is_final and carried != 1:
				return (
					"level %d is elite and its final wave (wave %d) carries %d sub-boss(es); "
					+ "an elite carries exactly one"
				) % [level_index, wave.number, carried]
			if not is_final and carried > 0:
				return "level %d wave %d carries a sub-boss; an elite's wall is on its final wave only" % [
					level_index, wave.number
				]
	if elite_in and total_sub_bosses != 1:
		return "level %d is elite and carries %d sub-boss(es) in total; an elite carries exactly one" % [
			level_index, total_sub_bosses
		]
	return ""


func _sub_boss_kinds() -> Array:
	return sub_boss_pool.duplicate()


# --- reporting --------------------------------------------------------------

## The numbers a wave count is judged on, for a demo or a log line: waves, units,
## enemy health, and how many sub-bosses the whole level carries.
func describe_level(waves: Array) -> Dictionary:
	var units := 0
	var health := 0
	var sub_bosses := 0
	var lines: Array = []
	for wave in waves:
		if wave == null:
			continue
		units += wave.unit_count()
		health += wave.total_health()
		sub_bosses += wave.units_of_kind(_sub_boss_kinds())
		lines.append(wave.describe())
	return {
		"waves": waves.size(),
		"units": units,
		"health": health,
		"sub_bosses": sub_bosses,
		"wave_lines": lines,
	}


# --- small helpers ----------------------------------------------------------

func _threat(kind: StringName) -> float:
	return maxf(float(threat_by_kind.get(kind, 1.0)), 0.0)


func _pack(kind: StringName) -> int:
	return maxi(int(pack_by_kind.get(kind, 1)), 1)


func _weight(kind: StringName, weights: Dictionary) -> float:
	return maxf(float(weights.get(kind, 0.0)), 0.0)


## A fresh line for `kind`. Always built from the roster template, never from a
## line already in a plan, so scaling a level never mutates a resource another
## level is still using.
func _line_for(kind: StringName, count: int, spacing: float) -> WaveEntry:
	var template := _roster_line(kind)
	var entry := WaveEntry.new()
	entry.kind = kind
	entry.count = count
	entry.spacing_seconds = maxf(spacing, 0.01)
	entry.max_health = template.max_health
	entry.gold_reward = template.gold_reward
	entry.move_speed = template.move_speed
	return entry


func _roster_line(kind: StringName) -> WaveEntry:
	for line in roster:
		if line != null and line.kind == kind:
			return line
	print("WAVE_PLAN_ROSTER " + JSON.stringify({
		"kind": kind,
		"reason": "no roster line for this kind; fallen back to the WaveEntry defaults",
	}))
	return WaveEntry.new()


func _heavier_first(a: WaveEntry, b: WaveEntry) -> bool:
	return _threat(a.kind) > _threat(b.kind)


func _cheaper_first(a: WaveEntry, b: WaveEntry) -> bool:
	return _threat(a.kind) < _threat(b.kind)


func _round_half(value: float) -> float:
	return round(value * 2.0) / 2.0
