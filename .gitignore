# Godot 4
.godot/
*.translation

# Builds and exports
build/
*.exe
*.pck
*.zip

# Secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# OS and editor noise
Thumbs.db
desktop.ini
.DS_Store
*.swp

# Local tooling scratch
.tmp/

# In-place mutation guard - never commit these (T-0031)
#
# A mutator writes the sentinel before touching a file and restore.ps1 removes it
# only after every recorded SHA-256 verifies. Ignoring both paths is what makes a
# mutation uncommittable; scripts/gate/mutation.ps1 is what makes it loud.
.mutation-active
.mutation-backup/
